# ─────────────────────────────────────────────────────────────────
#  FsocietyPK – Backend Environment Variables
#  Copy this file to .env and fill in values
# ─────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# ── Database ──────────────────────────────────────────────────────
MONGODB_URI=mongodb://fsociety_admin:SecurePass%402024@localhost:27017/fsocietypk?authSource=admin
MONGODB_URI_PROD=mongodb+srv://<user>:<password>@cluster.mongodb.net/fsocietypk

# ── Private challenge attachments (Cloudflare R2) ─────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# ── Authentication ────────────────────────────────────────────────
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
# Optional separate stable secret (32+ chars) for encrypted admin flag storage.
# If omitted, storage derives its key from JWT_SECRET; keep that key stable.
# FLAG_ENCRYPTION_SECRET=
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_IN=7

# ── CORS ─────────────────────────────────────────────────────────
# Frontend origins only (not the API hostname). Add the exact Vercel/custom site origin.
CORS_ORIGIN=http://localhost:5173,https://fsocietypk.tech,https://www.fsocietypk.tech
CORS_ALLOW_VERCEL_PREVIEWS=false
# Set to 1 behind exactly one trusted reverse proxy (for correct client IP rate limits).
# Leave at 0 when the app is directly exposed to the internet.
TRUST_PROXY_HOPS=0

# ── Rate Limiting ─────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ── Admin Seed ───────────────────────────────────────────────────
ADMIN_EMAIL=admin@fsocietypk.com
ADMIN_PASSWORD=replace-with-a-unique-admin-password
ADMIN_USERNAME=fsociety_admin

# ── Submission email alerts (optional; Gmail SMTP example) ──
# Use an App Password from the sending Gmail account (requires 2-Step Verification).
# Keep SMTP_PASSWORD private and set these in the backend deployment environment.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-sending-gmail@gmail.com
SMTP_PASSWORD=your-16-character-app-password
# Shared recipient for challenge, writeup, resource and project notifications.
CHALLENGE_NOTIFICATION_EMAIL=thefsocietypk@gmail.com

# ── Logging ───────────────────────────────────────────────────────
LOG_LEVEL=debug
